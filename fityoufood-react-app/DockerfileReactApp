FROM node:18 AS build

WORKDIR /app

COPY fityoufood-react-app/package.json fityoufood-react-app/package-lock.json ./

RUN npm install

COPY fityoufood-react-app/ ./

RUN npm run build

FROM nginx:alpine

COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
